{
  "opencollection": "1.0.0",
  "info": {
    "name": "SonarQube Cloud Web authentication users API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "users",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Lists the groups a user belongs to. Requires the permission 'Administer' on the organization.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://sonarcloud.io/api/users/groups",
            "params": [
              {
                "name": "login",
                "value": "admin",
                "type": "query",
                "description": "A user login"
              },
              {
                "name": "organization",
                "value": "my-org",
                "type": "query",
                "description": "Organization key"
              },
              {
                "name": "p",
                "value": "42",
                "type": "query",
                "description": "1-based page number"
              },
              {
                "name": "ps",
                "value": "20",
                "type": "query",
                "description": "Page size. Must be greater than 0."
              },
              {
                "name": "q",
                "value": "users",
                "type": "query",
                "description": "Limit search to group names that contain the supplied string."
              },
              {
                "name": "selected",
                "value": "",
                "type": "query",
                "description": "Depending on the value, show only selected items (selected=selected), deselected items (selected=deselected), or all items with their selection status (selected=all)."
              }
            ]
          },
          "docs": "Lists the groups a user belongs to. Requires the permission 'Administer' on the organization."
        }
      ]
    }
  ],
  "bundled": true
}