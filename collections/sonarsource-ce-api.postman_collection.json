          "id": "7ffb0eff-9795-4495-aabe-1f0e6ca229cc",
          "name": "Search for tasks. Either componentId or component can be provided, but not both. Requires the project administration ...",
          "request": {
            "name": "Search for tasks. Either componentId or component can be provided, but not both. Requires the project administration ...",
            "description": {
              "content": "Search for tasks. Either componentId or component can be provided, but not both. Requires the project administration permission if componentId or component is set.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "ce",
                "activity"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "component",
                  "value": "<string>",
                  "description": "Key of the component (project) to filter on"
                },
                {
                  "disabled": false,
                  "key": "componentId",
                  "value": "<string>",
                  "description": "Id of the component (project) to filter on"
                },
                {
                  "disabled": false,
                  "key": "maxExecutedAt",
                  "value": "<string>",
                  "description": "Maximum date of end of task processing (inclusive)"
                },
                {
                  "disabled": false,
                  "key": "minSubmittedAt",
                  "value": "<string>",
                  "description": "Minimum date of task submission (inclusive)"
                },
                {
                  "disabled": false,
                  "key": "onlyCurrents",
                  "value": "false",
                  "description": "Filter on the last tasks (only the most recent finished task by project)"
                },
                {
                  "disabled": false,
                  "key": "ps",
                  "value": "100",
                  "description": "Page size. Must be greater than 0 and less or equal than 1000"
                },
                {
                  "disabled": false,
                  "key": "q",
                  "value": "<string>",
                  "description": "Limit search to: component names that contain the supplied stringcomponent keys that are exactly the same as the supplied stringtask ids that are exactly the same as the supplied stringMust not be set together with componentId"
                },
                {
                  "disabled": false,
                  "key": "status",
                  "value": "SUCCESS,FAILED,CANCELED",
                  "description": "Comma separated list of task statuses"
                },
                {
                  "disabled": false,
                  "key": "type",
                  "value": "<string>",
                  "description": "Task type"
                }
              ],
              "variable": []
            },
            "method": "GET",
