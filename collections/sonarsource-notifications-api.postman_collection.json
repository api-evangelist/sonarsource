        {
          "id": "67fc4343-5487-413e-92ca-282d7c523b66",
          "name": "Add a notification for the authenticated user. Requires one of the following permissions: Authentication if no login ...",
          "request": {
            "name": "Add a notification for the authenticated user. Requires one of the following permissions: Authentication if no login ...",
            "description": {
              "content": "Add a notification for the authenticated user. Requires one of the following permissions: Authentication if no login is provided. If a project is provided, requires the 'Browse' permission on the specified project. If a project is provided, requires the 'Browse' permission on the specified project.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "notifications",
                "add"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "channel",
                  "value": "EmailNotificationChannel",
                  "description": "Channel through which the notification is sent. For example, notifications can be sent by email."
                },
                {
                  "disabled": false,
                  "key": "login",
                  "value": "<string>",
                  "description": "User login"
                },
                {
                  "disabled": false,
                  "key": "project",
                  "value": "<string>",
                  "description": "Project key"
                },
                {
                  "disabled": false,
                  "key": "type",
                  "value": "<string>",
                  "description": "(Required) Notification type. Possible values are for: Global notifications: CeReportTaskFailure, ChangesOnMyIssue, SQ-MyNewIssues Per project notifications: CeReportTaskFailure, ChangesOnMyIssue, NewAlerts, NewFalsePositiveIssue, NewIssues, SQ-MyNewIssues"
                }
