{
  "opencollection": "1.0.0",
  "info": {
    "name": "SonarQube Cloud Web authentication duplications API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "duplications",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get duplications. Require Browse permission on file's project",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://sonarcloud.io/api/duplications/show",
            "params": [
              {
                "name": "branch",
                "value": "feature/my_branch",
                "type": "query",
                "description": "Branch key"
              },
              {
                "name": "key",
                "value": "my_project:/src/foo/Bar.php",
                "type": "query",
                "description": "File key"
              },
              {
                "name": "pullRequest",
                "value": "5461",
                "type": "query",
                "description": "Pull request id"
              },
              {
                "name": "uuid",
                "value": "584a89f2-8037-4f7b-b82c-8b45d2d63fb2",
                "type": "query",
                "description": "File ID. If provided, 'key' must not be provided."
              }
            ]
          },
          "docs": "Get duplications. Require Browse permission on file's project"
        }
      ]
    }
  ],
  "bundled": true
}